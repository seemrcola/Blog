---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const path = Astro.url.pathname.replace(base.replace(/\/$/, ''), '') || '/';
---

<header>
  <a class="brand" href={base}><span>zk@notes</span>:~$</a>
  <nav aria-label="主导航">
    <a class:list={{ active: path === '/' || path.startsWith('/blog/') }} href={base}>./posts</a>
    <a class:list={{ active: path === '/about/' }} href={`${base}about/`}>./about</a>
  </nav>
</header>

<style>
  header { display: flex; align-items: center; justify-content: space-between; padding: 28px 0; }
  .brand { color: var(--muted); font: 600 .82rem var(--mono); }
  .brand span { color: var(--ink); }
  nav { display: flex; gap: 24px; }
  nav a { color: var(--muted); font: .8rem var(--mono); }
  nav a:hover, nav a.active { color: var(--ink); text-decoration: underline; text-underline-offset: 5px; }
</style>
