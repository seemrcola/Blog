<div class="code-blocks" data-code-blocks>
  <slot />
</div>

<style>
  .code-blocks { --code-block-max-height: 416px; }
  .code-blocks :global(pre) {
    overflow-x: auto;
    margin: 1.6em 0;
    padding: 18px 20px;
    background: #fff !important;
    color: #393a34;
  }
  .code-blocks :global(pre code) {
    padding: 0;
    background: transparent;
    font: .82rem/1.65 var(--mono);
  }
  .code-blocks :global(.code-block) {
    position: relative;
    margin: 1.6em 0;
    background: #fff;
  }
  .code-blocks :global(.code-block pre) {
    margin: 0;
    padding-right: 72px;
  }
  .code-blocks :global(.code-block.is-expandable:not(.is-expanded) pre) {
    max-height: var(--code-block-max-height);
    overflow-y: hidden;
  }
  .code-blocks :global(.code-block-copy) {
    position: absolute;
    z-index: 2;
    top: 10px;
    right: 12px;
    min-height: 28px;
    padding: 4px 6px 3px;
    border: 0;
    border-bottom: 1px solid transparent;
    color: var(--muted);
    background: rgb(255 255 255 / .88);
    font: 500 .7rem var(--mono);
    cursor: pointer;
  }
  .code-blocks :global(.code-block-copy:hover) {
    border-bottom-color: var(--line);
    color: var(--ink);
  }
  .code-blocks :global(.code-block-copy:focus-visible) {
    border-bottom-color: var(--ink);
    outline: 0;
    box-shadow: 0 1px 0 var(--ink);
    color: var(--ink);
  }
  .code-blocks :global(.code-block-action) {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 112px;
    padding-bottom: 16px;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0), rgb(255 255 255 / .92) 54%, #fff);
    pointer-events: none;
  }
  .code-blocks :global(.is-expanded .code-block-action) {
    position: static;
    align-items: center;
    height: 52px;
    padding: 0;
    border-top: 1px solid rgb(190 197 193 / .45);
    background: #fff;
  }
  .code-blocks :global(.code-block-toggle) {
    min-height: 32px;
    padding: 6px 8px 5px;
    border: 0;
    border-bottom: 1px solid transparent;
    color: var(--muted);
    background: transparent;
    font: 500 .72rem var(--mono);
    cursor: pointer;
    pointer-events: auto;
  }
  .code-blocks :global(.code-block-toggle::after) {
    margin-left: 6px;
    content: '↓';
  }
  .code-blocks :global(.code-block-toggle[aria-expanded='true']::after) { content: '↑'; }
  .code-blocks :global(.code-block-toggle:hover) {
    border-bottom-color: var(--line);
    color: var(--ink);
  }
  .code-blocks :global(.code-block-toggle:focus-visible) {
    border-bottom-color: var(--ink);
    outline: 0;
    box-shadow: 0 1px 0 var(--ink);
    color: var(--ink);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-code-blocks]').forEach((root) => {
    const maxHeight = Number.parseFloat(getComputedStyle(root).getPropertyValue('--code-block-max-height'));

    root.querySelectorAll<HTMLElement>('pre').forEach((pre, index) => {
      const isExpandable = pre.scrollHeight > maxHeight;
      const wrapper = document.createElement('div');
      const copyButton = document.createElement('button');

      wrapper.className = `code-block${isExpandable ? ' is-expandable' : ''}`;
      copyButton.className = 'code-block-copy';
      copyButton.type = 'button';
      copyButton.textContent = '复制';
      copyButton.setAttribute('aria-live', 'polite');

      pre.before(wrapper);
      wrapper.append(pre, copyButton);

      let resetTimer: number | undefined;
      copyButton.addEventListener('click', async () => {
        clearTimeout(resetTimer);
        const code = pre.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          copyButton.textContent = '已复制';
        } catch {
          const textarea = document.createElement('textarea');
          textarea.value = code;
          textarea.setAttribute('aria-hidden', 'true');
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.append(textarea);
          textarea.select();
          const copied = document.execCommand('copy');
          textarea.remove();
          copyButton.focus();
          copyButton.textContent = copied ? '已复制' : '复制失败';
        }
        resetTimer = window.setTimeout(() => { copyButton.textContent = '复制'; }, 1600);
      });

      if (!isExpandable) return;

      const action = document.createElement('div');
      const button = document.createElement('button');

      action.className = 'code-block-action';
      button.className = 'code-block-toggle';
      button.type = 'button';
      button.textContent = '加载更多';
      button.setAttribute('aria-expanded', 'false');
      pre.id ||= `code-block-${index + 1}`;
      button.setAttribute('aria-controls', pre.id);

      wrapper.append(action);
      action.append(button);

      button.addEventListener('click', () => {
        const expanded = wrapper.classList.toggle('is-expanded');
        button.textContent = expanded ? '收起代码' : '加载更多';
        button.setAttribute('aria-expanded', String(expanded));
      });
    });
  });
</script>
