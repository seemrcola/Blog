---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeBlocks from '../../components/CodeBlocks.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      previous: posts[index - 1],
      next: posts[index + 1],
    },
  }));
}

const { post, previous, next } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const { Content, headings } = await render(post);
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
const date = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric'
}).format(post.data.date);
---

<BaseLayout title={`${post.data.title} | ZK / NOTES`} description={post.data.description}>
  <article>
    <header>
      <a class="back" href={base}><span>$</span> cd ../..</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{date}</time>
        {post.data.status && (
          <span class:list={['status', post.data.status]}>
            {post.data.status === 'complete' ? '已完成' : '进行中'}
          </span>
        )}
        <span>{post.data.tags.map((tag) => `#${tag}`).join(' ')}</span>
      </div>
    </header>
    <div class:list={['article-body', { 'with-toc': toc.length > 0 }]}>
      {toc.length > 0 && (
        <aside class="toc">
          <p>本文目录</p>
          <nav aria-label="本文目录">
            <ol>
              {toc.map((heading) => (
                <li data-depth={heading.depth}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
      <div class="prose"><CodeBlocks><Content /></CodeBlocks></div>
    </div>
    <nav class="post-nav" aria-label="文章导航">
      {previous ? (
        <a href={`${base}blog/${previous.id}/`}>
          <span>$ cd ../{previous.id}</span>
          <strong>{previous.data.title}</strong>
        </a>
      ) : <span />}
      {next ? (
        <a class="next" href={`${base}blog/${next.id}/`}>
          <span>$ cd ../{next.id}</span>
          <strong>{next.data.title}</strong>
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  article { padding: 58px 0 120px; }
  article > header { padding-bottom: 36px; border-bottom: 1px solid var(--line); }
  .back { color: var(--muted); font: .76rem var(--mono); }
  .back span { color: var(--ink); }
  h1 { max-width: 850px; margin: 38px 0 24px; font-size: clamp(1.9rem, 4vw, 2.5rem); }
  .meta { display: flex; gap: 22px; color: var(--muted); font: .72rem var(--mono); }
  .status { display: inline-flex; align-items: center; gap: 5px; }
  .status::before { width: 6px; height: 6px; border-radius: 50%; background: #b07d48; content: ''; }
  .status.complete::before { background: #59873a; }
  .article-body { display: grid; grid-template-columns: minmax(0, 700px); justify-content: center; margin-top: 56px; }
  .article-body.with-toc { grid-template-columns: 180px minmax(0, 700px); gap: 40px; }
  .prose { width: 100%; font-family: ui-serif, Georgia, "Noto Serif SC", serif; font-size: 1.06rem; }
  .prose :global(h2), .prose :global(h3) { scroll-margin-top: 24px; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .prose :global(h2) { margin: 2.4em 0 .8em; font-size: 1.55rem; }
  .prose :global(h3) { margin: 2em 0 .7em; font-size: 1.2rem; }
  .prose :global(p) { margin: 1.25em 0; }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 4px; }
  .prose :global(blockquote) { margin: 2em 0; padding-left: 22px; border-left: 3px solid var(--ink); color: var(--muted); }
  .prose :global(code) { padding: .15em .35em; background: var(--surface); font-size: .84em; }
  .toc { position: sticky; top: 24px; max-height: calc(100vh - 48px); overflow: auto; align-self: start; }
  .toc > p { margin: 0 0 12px; color: var(--muted); font: 700 .7rem var(--mono); }
  .toc ol { margin: 0; padding: 0; list-style: none; }
  .toc a { display: block; padding: 5px 0 5px 12px; border-left: 1px solid var(--line); color: var(--muted); font: .72rem/1.5 var(--mono); }
  .toc li[data-depth='3'] a { padding-left: 24px; }
  .toc a:hover, .toc a.active { border-color: var(--ink); color: var(--ink); }
  .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 80px; padding-top: 30px; border-top: 1px solid var(--line); }
  .post-nav a { display: grid; gap: 5px; }
  .post-nav a:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .post-nav span { color: var(--muted); font: .7rem var(--mono); }
  .post-nav strong { font-size: .95rem; }
  .post-nav .next { text-align: right; }
  @media (max-width: 600px) {
    .post-nav { gap: 18px; }
  }
  @media (max-width: 820px) {
    .article-body.with-toc { grid-template-columns: minmax(0, 700px); gap: 36px; }
    .toc { position: static; max-height: 180px; padding: 16px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const sections = links
    .map((link) => document.getElementById(link.getAttribute('href')?.slice(1) ?? ''))
    .filter((section): section is HTMLElement => section !== null);

  const updateActiveLink = () => {
    const active = sections.findLast((section) => section.getBoundingClientRect().top <= 120) ?? sections[0];
    links.forEach((link) => {
      const isActive = link.getAttribute('href') === `#${active?.id}`;
      link.classList.toggle('active', isActive);
      isActive ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current');
    });
  };

  updateActiveLink();
  document.addEventListener('scroll', updateActiveLink, { passive: true });
</script>
